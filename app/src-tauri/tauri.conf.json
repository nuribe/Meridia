{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meridia",
  "version": "0.1.0",
  "identifier": "com.pgdiagrammer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meridia",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
